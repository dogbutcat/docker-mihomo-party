#!/command/with-contenv bash
# 门控：WARP 未启用则跳过
if [ "${WARP}" != "true" ]; then exit 0; fi

set -euo pipefail
mkdir -p /var/lib/cloudflare-warp /run/dbus
rm -f /run/dbus/pid

if [ ! -d /dev/net ]; then mkdir -p /dev/net; fi
if [ ! -c /dev/net/tun ]; then
  mknod /dev/net/tun c 10 200
  chmod 0666 /dev/net/tun
fi
echo "WARP runtime environment initialized"
