#!/command/with-contenv bash
# shellcheck shell=bash

# === init-fix-routes ===
# 架构核心：先发制人，绝不等待 Clash 启动！
# 利用 fix-routes 的静态预占位能力，开机瞬间强行铺设内核逃生通道。
# 等后续 Mihomo 启动时，它的 routing-mark 流量会直接命中已就绪的绿色通道。
#
# 原理：fix-routes 使用固定表号 65743 + 默认优先级 8997/8998，
# 借助 Linux 空表穿透特性，无论 WARP/ZT/Clash 是否启动都安全无害。

echo "=== init-fix-routes: 提前预部署底层路由 ==="

if [ -x /usr/bin/fix-routes ]; then
    /usr/bin/fix-routes
    echo "[done] fix-routes 执行完毕，底层架构已就绪"
else
    echo "[error] /usr/bin/fix-routes 不存在或不可执行!"
    exit 1
fi

exit 0
