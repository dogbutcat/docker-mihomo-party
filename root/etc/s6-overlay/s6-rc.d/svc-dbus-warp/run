#!/command/with-contenv bash
if [ "${WARP}" != "true" ]; then exec sleep infinity; fi

# KasmVNC 桌面环境可能已运行 system dbus，检测避免冲突
if [ -S /run/dbus/system_bus_socket ]; then
  echo "system dbus already running, skipping svc-dbus-warp"
  exec sleep infinity
fi

exec /usr/bin/dbus-daemon --system --nofork
