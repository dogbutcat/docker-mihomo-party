#!/bin/bash
# debug-network.sh - Diagnose Clash/Warp/ZeroTier connectivity

echo "=== 1. Interface & IP Info ==="
ip addr show

echo -e "\n=== 2. Routing Table ==="
ip route show table all

echo -e "\n=== 3. Routing Rules (Policy Routing) ==="
ip rule show

echo -e "\n=== 4. IPTables (NAT & Mangle) ==="
# Filter for relevant chains to avoid spam
iptables-save | grep -E "CloudflareWARP|clash|MASQUERADE|MARK|REDIRECT|TPROXY" || echo "No relevant iptables rules found."

echo -e "\n=== 5. Process Owner Check ==="
echo "Clash Process User:"
ps aux | grep clash | grep -v grep

echo -e "\n=== 6. Connectivity Test (Root) ==="
# Test Google (Internet)
echo "Interact with Google (via Default Route):"
curl -I -m 5 https://www.google.com || echo "Failed"

# Test Warp Interface explicitly
if ip link show CloudflareWARP >/dev/null 2>&1; then
    echo "Interact via CloudflareWARP interface:"
    curl -I -m 5 --interface CloudflareWARP https://1.1.1.1 || echo "Failed"
else
    echo "CloudflareWARP interface not present."
fi

echo -e "\n=== 7. Environment Variables ==="
env | grep -E "WARP|PROXY|ZT"
