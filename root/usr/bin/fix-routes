#!/bin/bash
set -e

# === 修复 Clash Tun 模式下的路由死锁问题 ===
#
# 问题根源:
#   1. auto-detect-interface=true 时, Clash 用 SO_BINDTODEVICE 强绑物理网卡,
#      导致发往 WARP/ZeroTier 虚拟网卡的流量被强制走物理路由器, Timeout.
#   2. auto-detect-interface=false 时, Clash 自己发出的包 (源 0.0.0.0)
#      会被 rule 9002 送回 TUN, 形成无限死循环, 全网瘫痪.
#   3. [新增] 阻断 IPv6 黑洞 (解决网页变慢、转圈问题)
#   4. [新增] 修复跨网段 MTU 黑洞 (解决局域网设备丢包)

ROUTING_MARK="${ROUTING_MARK:-6666}"

echo "=== fix-routes: 基于 fwmark 的静态路由修复 (满血提速版) ==="
echo "[info] routing-mark: ${ROUTING_MARK}"

# --- 1. 获取 WARP 路由表编号 ---
WARP_TABLE=65743
echo "[info] 预设固定 WARP 路由表: ${WARP_TABLE}"

# --- 2. 动态检测插入位置 ---
CLASH_RULE_PRIO=$(ip rule show 2>/dev/null | grep 'lookup 2022' | awk -F: '{print $1}' | tr -d ' \t' | head -n 1 || true)

# 留出 3 个空位，避免与 WARP 的 8999 规则冲突
if [ -n "$CLASH_RULE_PRIO" ] && [ "$CLASH_RULE_PRIO" -gt 4 ]; then
    PRIO_WARP=$((CLASH_RULE_PRIO - 4))
    PRIO_MAIN=$((CLASH_RULE_PRIO - 3))
    PRIO_UNREACH=$((CLASH_RULE_PRIO - 2)) # 新增: 黑洞隔离层
    echo "[info] 检测到 Clash 规则优先级: ${CLASH_RULE_PRIO}, 插入位置: ${PRIO_WARP}/${PRIO_MAIN}/${PRIO_UNREACH}"
else
    PRIO_WARP=8995
    PRIO_MAIN=8996
    PRIO_UNREACH=8997
    echo "[info] 未检测到 Clash 规则, 使用默认优先级: ${PRIO_WARP}/${PRIO_MAIN}/${PRIO_UNREACH}"
fi

# --- 3. 清理旧规则 (幂等清理) ---
echo "[info] 清理旧的 fwmark ${ROUTING_MARK} 规则..."
while ip -4 rule del fwmark "${ROUTING_MARK}" 2>/dev/null; do true; done
while ip -6 rule del fwmark "${ROUTING_MARK}" 2>/dev/null; do true; done
# 旧的清理规则可能不包含 unreachable 动作，增加稳妥清理
while ip -4 rule del fwmark "${ROUTING_MARK}" unreachable 2>/dev/null; do true; done
while ip -6 rule del fwmark "${ROUTING_MARK}" unreachable 2>/dev/null; do true; done

# --- 4. 添加绿色通道 ---

# 4a. WARP 表绿色通道 (无论 WARP 是否运行，强制预留)
echo "[add] fwmark ${ROUTING_MARK} lookup ${WARP_TABLE} prio ${PRIO_WARP} (IPv4/IPv6)"
ip -4 rule add fwmark "${ROUTING_MARK}" lookup "${WARP_TABLE}" prio "${PRIO_WARP}"
ip -6 rule add fwmark "${ROUTING_MARK}" lookup "${WARP_TABLE}" prio "${PRIO_WARP}" 2>/dev/null || true

# 4b. main 表绿色通道 (解决 ZeroTier/Docker/公网出海, 彻底打破死循环)
echo "[add] fwmark ${ROUTING_MARK} lookup main prio ${PRIO_MAIN} (IPv4/IPv6)"
ip -4 rule add fwmark "${ROUTING_MARK}" lookup main prio "${PRIO_MAIN}"
ip -6 rule add fwmark "${ROUTING_MARK}" lookup main prio "${PRIO_MAIN}" 2>/dev/null || true

# 4c. ⚡ 核心提速补丁：隔离黑洞 (防 IPv6 Fall-through 造成的网页转圈慢半拍)
echo "[add] fwmark ${ROUTING_MARK} unreachable prio ${PRIO_UNREACH} (IPv4/IPv6)"
ip -4 rule add fwmark "${ROUTING_MARK}" unreachable prio "${PRIO_UNREACH}"
ip -6 rule add fwmark "${ROUTING_MARK}" unreachable prio "${PRIO_UNREACH}" 2>/dev/null || true

# --- 5. 修复跨网段丢包 (精准版 MTU/TCPMSS 钳制) ---
echo ""
echo "[info] 配置精准 iptables TCP MSS 钳制..."

# 1. 彻底清理之前可能遗留的“闯祸”全局规则，确保 Docker 桥接网络绝对安全
while iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null; do true; done
# 清理旧的精准规则，防止每次运行脚本重复添加
while iptables -t mangle -D FORWARD -o CloudflareWARP -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null; do true; done
while iptables -t mangle -D FORWARD -i CloudflareWARP -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null; do true; done

# 2. 精准制导：只对发往/来自 WARP 隧道的流量修改 MTU，绝不干扰 macvtap 和 docker0！
iptables -t mangle -A FORWARD -o CloudflareWARP -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
iptables -t mangle -A FORWARD -i CloudflareWARP -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

# --- 6. 验证 ---
echo ""
echo "=== 当前 fwmark ${ROUTING_MARK} 绿色通道规则 ==="
# 新版 iproute2 可能会将 6666 转为十六进制 0x1a0a，使用十六进制辅助匹配
HEX_MARK=$(printf '0x%x' "${ROUTING_MARK}")
ip rule show | grep -iE "fwmark (${HEX_MARK}|${ROUTING_MARK})" || echo "(无 - 异常!)"

echo ""
# 自动修正固定路径的 Mihomo 配置; 不存在则回退提醒
MIHOMO_CONFIG="/mihomo-data/mihomo-party/mihomo.yaml"
if [ -f "$MIHOMO_CONFIG" ]; then
    # routing-mark: 已有则更新, 没有则追加
    if grep -q '^\s*routing-mark:' "$MIHOMO_CONFIG"; then
        sed -i "s/^\(\s*\)routing-mark:.*/\1routing-mark: ${ROUTING_MARK}/" "$MIHOMO_CONFIG"
    else
        echo "routing-mark: ${ROUTING_MARK}" >> "$MIHOMO_CONFIG"
    fi

    # tun.auto-detect-interface: 已有则更新, 没有则尝试插入 tun 下
    if grep -q '^\s*auto-detect-interface:' "$MIHOMO_CONFIG"; then
        sed -i 's/^\(\s*\)auto-detect-interface:.*/\1auto-detect-interface: false/' "$MIHOMO_CONFIG"
    else
        if grep -q '^\s*tun:' "$MIHOMO_CONFIG"; then
            sed -i '/^\s*tun:/a\  auto-detect-interface: false' "$MIHOMO_CONFIG"
        else
            printf '\ntun:\n  auto-detect-interface: false\n' >> "$MIHOMO_CONFIG"
        fi
    fi

    echo "[done] 已自动修正 ${MIHOMO_CONFIG}:"
    echo "  routing-mark: ${ROUTING_MARK}"
    echo "  tun.auto-detect-interface: false"
else
    echo "=== 提醒 ==="
    echo "${MIHOMO_CONFIG} 不存在，请手动确保 Mihomo 配置了:"
    echo "  routing-mark: ${ROUTING_MARK}"
    echo "  tun:"
    echo "    auto-detect-interface: false"
fi